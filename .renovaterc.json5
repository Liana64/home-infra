{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled",
  ],
  timezone: "America/Chicago",
  automerge: false,
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  labels: ["default"],
  commitMessagePrefix: "[{{replace '^(?:kubernetes/main/(?:apps/)?|[.])([^/]+).*$' '$1' packageFileDir}}]",
  dependencyDashboardTitle: "Renovate Dashboard",
  prBodyDefinitions: {
    Release: "{{#if sourceUrl}}[releases]({{{sourceUrl}}}/releases){{/if}}",
  },
  prBodyColumns: ["Package", "Type", "Update", "Change", "Release"],
  ignorePaths: [
    ".archive/**",
    "**/.terraform/**",
    "kubernetes/archived/**",
    "kubernetes/main/bootstrap/talos/clusterconfig/**",
    "kubernetes/main/apps/ai/openclaw/**",
    "kubernetes/main/apps/games/minecraft/**",
  ],
  packageRules: [
    {
      matchFileNames: [
        ".github/**",
        "kubernetes/main/bootstrap/**",
        "kubernetes/main/flux/**",
        "kubernetes/main/apps/{cert-manager,database,external-secrets,kube-system,observability,openebs,renovate,security,system,system-controllers,volsync-system}/**",
      ],
      labels: ["system"],
    },
    {
      matchFileNames: ["kubernetes/main/apps/{home,media,networking}/**"],
      labels: ["{{replace '^kubernetes/main/apps/([^/]+).*$' '$1' packageFileDir}}"],
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["breaking"],
    },
    {
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      addLabels: ["breaking"],
    },
    {
      matchPackageNames: ["fluxcd/flux2", "ghcr.io/fluxcd/flux-manifests"],
      groupName: "flux",
    },
    {
      matchPackageNames: ["dragonflydb/dragonfly-operator", "ghcr.io/dragonflydb/operator"],
      groupName: "dragonfly-operator",
    },
    {
      matchPackageNames: [
        "ghcr.io/liana64/mautrix-**",
        "ghcr.io/liana64/sec-tools",
        "ghcr.io/alexxit/go2rtc",
        "docker.io/owncast/owncast",
        "ghcr.io/element-hq/element-web",
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^v?\\d/",
      enabled: false,
    },
    {
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["digest"],
      enabled: true,
    },
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  "github-actions": {
    managerFilePatterns: ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      description: "Container images annotated above an image:/repository:/tag: block",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n(\\s+image:\\n)?(\\s+repository: \\S+\\n)?\\s+tag: (?<currentValue>[^@\"'\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "{{{datasource}}}",
      depNameTemplate: "{{{depName}}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
    },
    {
      customType: "regex",
      description: "Container images pinned inline as image: repo:tag@digest",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n\\s+image(?:Name)?: \\S+?:(?<currentValue>[^@\"'\\s:]+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "{{{datasource}}}",
      depNameTemplate: "{{{depName}}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
    },
    {
      customType: "regex",
      description: "Versions embedded in a remote manifest URL (e.g. github-releases CRDs)",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n\\s+- \\S+/(?<currentValue>v?\\d+\\.\\d+\\.\\d+)/",
      ],
      datasourceTemplate: "{{{datasource}}}",
      depNameTemplate: "{{{depName}}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Grafana dashboards by grafana.com id (bumps revision)",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: depName=\"(?<depName>.+?)\"\\n\\s+gnetId: (?<packageName>\\d+)\\n\\s+revision: (?<currentValue>\\d+)",
      ],
      datasourceTemplate: "grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
  ],
}
