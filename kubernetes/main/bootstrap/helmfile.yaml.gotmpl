---
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  #recreatePods: true
  #force: true

repositories:
  - name: cilium
    url: https://helm.cilium.io
  - name: coredns
    url: https://coredns.github.io/helm
  - name: postfinance
    url: https://postfinance.github.io/kubelet-csr-approver

releases:
  - name: prometheus-operator-crds
    namespace: observability
    chart: oci://ghcr.io/prometheus-community/charts/prometheus-operator-crds
    version: {{ (readFile "../apps/observability/prometheus-operator-crds/app/helmrelease.yaml" | fromYaml).spec.chart.spec.version }}
  - name: cilium
    namespace: kube-system
    chart: cilium/cilium
    version: {{ (readFile "../apps/kube-system/cilium/app/helmrelease.yaml" | fromYaml).spec.chart.spec.version }}
    values:
      - ../apps/kube-system/cilium/app/helm-values.yaml
    needs:
      - observability/prometheus-operator-crds
  - name: coredns
    namespace: kube-system
    chart: coredns/coredns
    version: {{ (readFile "../apps/kube-system/coredns/app/helmrelease.yaml" | fromYaml).spec.chart.spec.version }}
    values:
      - ../apps/kube-system/coredns/app/helm-values.yaml
    needs:
      - observability/prometheus-operator-crds
      - kube-system/cilium
  - name: kubelet-csr-approver
    namespace: system-controllers
    chart: postfinance/kubelet-csr-approver
    version: {{ (readFile "../apps/system-controllers/kubelet-csr-approver/app/helmrelease.yaml" | fromYaml).spec.chart.spec.version }}
    values:
      - ../apps/system-controllers/kubelet-csr-approver/app/helm-values.yaml
    needs:
      - observability/prometheus-operator-crds
      - kube-system/cilium
      - kube-system/coredns
  - name: spegel
    namespace: system
    chart: oci://ghcr.io/spegel-org/helm-charts/spegel
    version: {{ (readFile "../apps/system/spegel/app/ocirepository.yaml" | fromYaml).spec.ref.tag }}
    values:
      - ../apps/system/spegel/app/helm-values.yaml
    needs:
      - observability/prometheus-operator-crds
      - kube-system/cilium
      - kube-system/coredns
      - system-controllers/kubelet-csr-approver
