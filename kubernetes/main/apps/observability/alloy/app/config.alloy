logging {
	level  = "info"
	format = "logfmt"
}

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
	stage.match {
		selector = "{app=\"jellyfin\"}"

		stage.multiline {
			firstline     = "^\\[\\d{2}:\\d{2}:\\d{2}\\]"
			max_wait_time = "3s"
		}
	}

	stage.structured_metadata {
		values = {
			pod  = "",
			node = "",
		}
	}

	stage.label_drop {
		values = ["pod", "node", "instance"]
	}
	forward_to = [loki.process.redact.receiver]
}

// Credit:
//   https://github.com/szinn/k8s-homelab/tree/main/kubernetes/main/apps/observability/alloy
//   https://github.com/dmfrey/home-gitops/tree/main/kubernetes/apps/observability/alloy
loki.source.kubernetes_events "cluster" {
	log_format = "logfmt"
	forward_to = [loki.process.redact.receiver]
}

loki.relabel "syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "syslog_app"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "level"
	}

	rule {
		target_label = "sender"
		replacement  = "unknown"
	}

	// Allowlist: one rule per device, e.g.
	//   rule {
	//     source_labels = ["__syslog_connection_ip_address"]
	//     regex         = "172\\.16\\.99\\.1"
	//     target_label  = "sender"
	//     replacement   = "router"
	//   }

	rule {
		source_labels = ["sender"]
		regex         = "unknown"
		action        = "drop"
	}
}

loki.source.syslog "lan" {
	listener {
		address  = "0.0.0.0:1514"
		protocol = "tcp"
		labels   = {job = "syslog"}
	}

	listener {
		address       = "0.0.0.0:1514"
		protocol      = "udp"
		syslog_format = "rfc3164"
		labels        = {job = "syslog"}
	}
	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.process.redact.receiver]
}

loki.source.api "vector" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3500
	}
	use_incoming_timestamp = true
	forward_to             = [loki.process.redact.receiver]
}

loki.process "redact" {
	stage.drop {
		expression = "^\\s*$"
	}

	stage.drop {
		older_than          = "167h"
		drop_counter_reason = "older_than_loki_max_age"
	}

	stage.replace {
		expression = "(?i)authorization[\"']?\\s*[=:]\\s*[\"']?(?:(?:bearer|basic|token)\\s+)?([^\\s\"',;&}]+)"
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = "(?i)(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key)[\"']?\\s*[=:]\\s*[\"']?([^\\s\"',;&}]+)"
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = "[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s:/@]*:([^\\s@/]+)@"
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = "(?i)(?:set-)?cookie[\"']?\\s*[=:]\\s*([^\\r\\n]+)"
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = "(eyJ[a-zA-Z0-9_-]+\\.eyJ[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+)"
		replace    = "[REDACTED]"
	}

	stage.replace {
		expression = "((?:AKIA|ASIA)[0-9A-Z]{16})"
		replace    = "[REDACTED]"
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push"
	}
}
